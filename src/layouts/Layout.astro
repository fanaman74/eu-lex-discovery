---
import '../styles/global.css';
import { query } from '../lib/db';
const { title = 'EU Lex Discovery', description = 'EU court rulings on rights at work, each linked to the official judgment on EUR-Lex.' } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/cases', label: 'Rulings', active: path.startsWith('/cases') },
  { href: '/monitoring', label: 'Monitoring', active: path.startsWith('/monitoring') },
  { href: '/settings', label: 'Settings', active: path.startsWith('/settings') }
];
let lastCheck: string | null = null;
try { lastCheck = (await query<{ last_checked_at: string | null }>("SELECT last_checked_at FROM sources WHERE key='eurlex-sparql'")).rows[0]?.last_checked_at ?? null; } catch { /* the bar simply omits the check time when the database is unreachable */ }
const checked = lastCheck ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Europe/Brussels' }).format(new Date(lastCheck)) : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title} · EU Lex Discovery</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="masthead">
      <a class="wordmark" href="/" aria-label="EU Lex Discovery, home">EU Lex <span>Discovery</span></a>
      <nav aria-label="Primary">
        {links.map((link) => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}
      </nav>
      {checked && <p class="masthead-check"><span>Source checked</span> <time datetime={lastCheck!}>{checked}</time></p>}
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="colophon">
      <p class="colophon-name">EU Lex Discovery</p>
      <p>Research support only. Always verify against the official judgment on <a href="https://eur-lex.europa.eu/" target="_blank" rel="noreferrer">EUR-Lex</a>. Rulings are found by a daily keyword search of the official source, so coverage is not exhaustive.</p>
      <p>Home page photograph: the Court of Justice of the European Union, Luxembourg, by <a href="https://commons.wikimedia.org/wiki/File:A_Bold_Entrance_to_European_Justice.jpg" target="_blank" rel="noreferrer">Simo.Albo80</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0" target="_blank" rel="noreferrer">CC BY-SA 4.0</a>, cropped.</p>
    </footer>
  </body>
</html>
